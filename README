1. удалил каталог beeware-venv



url=https://tutorial.beeware.org/tutorial/tutorial-1/
2. sudo apt update
3. sudo apt install git build-essential pkg-config python3-dev python3-venv libgirepository-2.0-dev libcairo2-dev gir1.2-gtk-3.0 libcanberra-gtk3-module
4. 	mkdir beeware-tutorial
	cd beeware-tutorial
	python3 -m venv beeware-venv
	source beeware-venv/bin/activate
5.python -m pip install briefcase
6. (beeware-venv) $ briefcase new
7. 	cd <dir_project>
	(beeware-venv) $ briefcase dev
8. (beeware-venv) $ briefcase create
9. (beeware-venv) $ briefcase build
10. (beeware-venv) $ briefcase run
11. (beeware-venv) $ briefcase package -> OS 
12. (beeware-venv) $ briefcase create android
13. (beeware-venv) $ briefcase build android
14 (beeware-venv) $ briefcase run android

